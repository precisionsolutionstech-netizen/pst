---
import Base from '../../layouts/Base.astro';
import apis from '../../data/apis.json';
import codeSamples from '../../data/api-code-samples.json';

export function getStaticPaths() {
  return apis.map((api) => ({ params: { slug: api.slug }, props: { api } }));
}

const { api } = Astro.props;
const SITE = 'https://precisionsolutionstech.com';
const pagePath = `/apis/${api.slug}/`;

const related = apis.filter((a) => a.category === api.category && a.slug !== api.slug).slice(0, 4);

// Generated by scripts/gen-code-samples.mjs from the playground scripts.
// The playground overwrites #generated-code on load; rendering the snippet
// server-side is what makes it visible to crawlers and AI agents, which do
// not execute JavaScript.
const sample = (codeSamples as Record<string, {
  host: string; path: string; method: string; upload: boolean;
  curl: string; javascript: string; python: string;
}>)[api.slug];

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// Seed the playground's empty <code> element so the snippet ships in the HTML.
const PLACEHOLDER = /<code id="generated-code"[^>]*>\s*<\/code>/;
const hasPlaceholder = sample ? PLACEHOLDER.test(api.contentHtml) : false;
const contentHtml = hasPlaceholder
  ? api.contentHtml.replace(PLACEHOLDER, `<code id="generated-code">${esc(sample.curl)}</code>`)
  : api.contentHtml;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'APIs', item: `${SITE}/apis/` },
      { '@type': 'ListItem', position: 3, name: api.name, item: `${SITE}${pagePath}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: api.h1,
    name: api.name,
    description: api.metaDescription,
    author: { '@type': 'Organization', name: 'Precision Solutions Tech' },
    url: `${SITE}${pagePath}`,
    ...(api.datePublished ? { datePublished: api.datePublished } : {}),
    ...(api.dateModified ? { dateModified: api.dateModified } : {}),
  },
  ...api.jsonLd,
];
---

<Base
  title={api.metaTitle}
  description={api.metaDescription}
  path={pagePath}
  ogType="article"
  active="apis"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/apis/">APIs</a></li>
        <li>{api.name}</li>
      </ol>
    </nav>

    <article>
      <header class="product-hero">
        <div class="hero-pills">
          <span class="pill pill-accent">{api.category}</span>
          <span class="pill">Live on RapidAPI</span>
        </div>
        <h1>{api.h1}</h1>
        <div set:html={api.heroHtml} class="product-body" />
      </header>

      <div class="product-body" set:html={contentHtml} />

      {sample && (
        <section class="product-body quickstart" id="quickstart" style="margin-top: 40px;">
          <h2 id="quickstart-heading">Quick start</h2>
          <p>
            <strong>{sample.method}</strong>{' '}
            <code>https://{sample.host}{sample.path}</code>{' '}
            — authenticate with the <code>x-rapidapi-key</code> and{' '}
            <code>x-rapidapi-host</code> headers from your{' '}
            <a href={api.rapidapiUrl} rel="noopener">RapidAPI subscription</a>.
          </p>
          {!hasPlaceholder && (
            <div class="code-wrap"><pre><code set:html={esc(sample.curl)} /></pre></div>
          )}
          <details>
            <summary>JavaScript (fetch)</summary>
            <div class="code-wrap"><pre><code set:html={esc(sample.javascript)} /></pre></div>
          </details>
          <details>
            <summary>Python (requests)</summary>
            <div class="code-wrap"><pre><code set:html={esc(sample.python)} /></pre></div>
          </details>
        </section>
      )}

      <section class="product-body" style="margin-top: 48px;">
        <div class="cta-row">
          <a class="btn btn-accent" href={api.rapidapiUrl} rel="noopener">
            Get {api.name} on RapidAPI
          </a>
          <span class="cta-sub">Free tier available — subscribe and get your API key in minutes.</span>
        </div>
      </section>

      {related.length > 0 && (
        <section class="product-body related-apis" style="margin-top: 40px;">
          <h2>More {api.category.replace(/ APIs$/, '')} APIs</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/apis/${r.slug}/`}>{r.name}</a> — {r.blurb}
              </li>
            ))}
          </ul>
          <p><a class="browse-all" href="/apis/">Browse the full API catalog &rarr;</a></p>
        </section>
      )}
    </article>
  </div>

  {/* Per-API playground scripts (unique hosts/samples/endpoints). Load after DOM. */}
  {(api.playgroundDeps || []).map((src) => (
    <script is:inline src={src} />
  ))}
  {api.playgroundScript && <script is:inline src={api.playgroundScript} />}

  <script>
    // FAQ accordion + schema show/hide toggles for migrated content.
    document.querySelectorAll('.faq-q').forEach((btn) => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        const target = btn.getAttribute('aria-controls');
        const panel = target
          ? document.getElementById(target)
          : btn.parentElement?.querySelector('.faq-a');
        if (panel) panel.classList.toggle('open', !expanded);
      });
    });
    document.querySelectorAll('.schema-toggle').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const href = el.getAttribute('href') || '';
        const target = href.startsWith('#') ? document.getElementById(href.slice(1)) : null;
        const panel = target?.classList.contains('schema-content')
          ? target
          : el.closest('.schema-section, section')?.querySelector('.schema-content');
        if (panel) panel.classList.toggle('show');
      });
    });
  </script>
</Base>
