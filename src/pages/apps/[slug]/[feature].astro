---
import Base from '../../../layouts/Base.astro';
import apps from '../../../data/apps.json';
import featureData from '../../../data/app-features.json';

const SITE = 'https://precisionsolutionstech.com';

export function getStaticPaths() {
  const featureMap = featureData as Record<string, { slug: string }[]>;
  return Object.entries(featureMap).flatMap(([slug, features]) =>
    features.map((f) => ({ params: { slug, feature: f.slug } }))
  );
}

const { slug, feature } = Astro.params;
const app = (apps as any[]).find((a) => a.slug === slug);
const features = (featureData as Record<string, any[]>)[slug!] ?? [];
const f = features.find((x) => x.slug === feature);

if (!app || !f) throw new Error(`Unknown feature: ${slug}/${feature}`);

const path = `/apps/${slug}/${feature}/`;
const related = (f.related ?? [])
  .map((r: string) => features.find((x) => x.slug === r))
  .filter(Boolean);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: f.h1,
    description: f.metaDescription,
    image: f.hero ? `${SITE}${f.hero.src}` : undefined,
    totalTime: 'PT5M',
    tool: [{ '@type': 'HowToTool', name: `${app.name} for macOS` }],
    step: f.steps.map((s: any, i: number) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.body.replace(/<[^>]+>/g, ''),
      url: `${SITE}${path}#step-${i + 1}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: f.faq.map((q: any) => ({
      '@type': 'Question',
      name: q.q,
      acceptedAnswer: { '@type': 'Answer', text: q.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Apps', item: `${SITE}/apps/` },
      { '@type': 'ListItem', position: 2, name: app.name, item: `${SITE}/apps/${slug}/` },
      { '@type': 'ListItem', position: 3, name: f.name, item: `${SITE}${path}` },
    ],
  },
];
---

<Base
  title={f.title}
  description={f.metaDescription}
  path={path}
  ogType="article"
  ogImage={f.hero?.src ?? app.ogImage}
  jsonLd={jsonLd}
  active="apps"
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/apps/">Apps</a> <span aria-hidden="true">/</span>
      <a href={`/apps/${slug}/`}>{app.name}</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{f.name}</span>
    </nav>

    <article class="feature">
      <header class="feature-hero">
        <p class="feature-kicker">{f.kicker}</p>
        <h1>{f.h1}</h1>
        <p class="feature-summary">{f.summary}</p>
        <div class="feature-cta-row">
          {app.appStoreUrl && (
            <a class="btn btn-primary" href={app.appStoreUrl} rel="noopener">
              Get {app.name} — {app.price}
            </a>
          )}
          {app.trialDownloadUrl && (
            <a class="btn btn-secondary" href={app.trialDownloadUrl} download>
              Download the free 7-day trial
            </a>
          )}
        </div>
      </header>

      {f.hero && (
        <figure class="feature-shot">
          <img src={f.hero.src} alt={f.hero.alt} loading="eager" width="2560" height="1600" />
        </figure>
      )}

      <section class="feature-block">
        <h2>What it's for</h2>
        <div set:html={f.whatFor} />
      </section>

      <section class="feature-block">
        <h2>How to use it</h2>
        <ol class="feature-steps">
          {f.steps.map((s: any, i: number) => (
            <li id={`step-${i + 1}`}>
              <h3>{s.title}</h3>
              <p set:html={s.body} />
            </li>
          ))}
        </ol>
      </section>

      <section class="feature-block" set:html={f.reference} />

      <section class="feature-block feature-faq">
        <h2>Common questions</h2>
        {f.faq.map((q: any) => (
          <details>
            <summary>{q.q}</summary>
            <p>{q.a}</p>
          </details>
        ))}
      </section>

      <section class="feature-bottom">
        <h2>Try it on your own files</h2>
        <p>
          {app.name} is a one-time {app.price} purchase — no subscription, no account, and
          nothing leaves your Mac. Requires {app.os}.
        </p>
        <div class="feature-cta-row">
          {app.appStoreUrl && (
            <a class="btn btn-primary" href={app.appStoreUrl} rel="noopener">
              Get on the Mac App Store
            </a>
          )}
          {app.purchaseUrl && (
            <a class="btn btn-secondary" href={app.purchaseUrl} rel="noopener">
              Buy direct on Gumroad
            </a>
          )}
        </div>
      </section>

      {related.length > 0 && (
        <nav class="feature-related" aria-label="More features">
          <h2>More {app.name} features</h2>
          <ul>
            {related.map((r: any) => (
              <li>
                <a href={`/apps/${slug}/${r.slug}/`}>{r.name}</a> — {r.summary.slice(0, 120)}…
              </li>
            ))}
            <li><a href={`/apps/${slug}/`}>Back to {app.name} overview</a></li>
          </ul>
        </nav>
      )}
    </article>
  </div>
</Base>

<style>
  .feature { max-width: 780px; margin: 0 auto 64px; }
  .feature-hero { margin: 8px 0 28px; }
  .feature-kicker {
    text-transform: uppercase; letter-spacing: .08em; font-size: .75rem;
    font-weight: 600; opacity: .6; margin: 0 0 6px;
  }
  .feature h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); line-height: 1.15; margin: 0 0 14px; }
  .feature-summary { font-size: 1.12rem; line-height: 1.6; opacity: .85; margin: 0 0 22px; }
  .feature-cta-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .feature-shot { margin: 0 0 36px; }
  .feature-shot img {
    width: 100%; height: auto; border-radius: 12px;
    border: 1px solid rgba(0,0,0,.09); box-shadow: 0 8px 28px rgba(0,0,0,.10);
  }
  .feature-block { margin: 0 0 36px; }
  .feature-block :global(h2) { font-size: 1.5rem; margin: 0 0 12px; }
  .feature-block :global(h3) { font-size: 1.08rem; margin: 0 0 6px; }
  .feature-block :global(p) { line-height: 1.62; margin: 0 0 12px; }
  .feature-block :global(ul) { line-height: 1.62; margin: 0 0 14px 20px; }
  .feature-block :global(li) { margin: 5px 0; }
  .feature-block :global(code) {
    font-size: .9em; padding: 1px 5px; border-radius: 4px; background: rgba(0,0,0,.06);
  }
  .feature-block :global(kbd) {
    font: inherit; font-size: .85em; padding: 2px 7px; border-radius: 5px;
    border: 1px solid rgba(0,0,0,.2); border-bottom-width: 2px; background: rgba(0,0,0,.03);
  }
  .feature-steps { list-style: none; counter-reset: step; padding: 0; margin: 0; }
  .feature-steps > li {
    counter-increment: step; position: relative;
    padding: 0 0 18px 46px; margin: 0 0 18px;
    border-bottom: 1px solid rgba(0,0,0,.07);
  }
  .feature-steps > li:last-child { border-bottom: 0; }
  .feature-steps > li::before {
    content: counter(step); position: absolute; left: 0; top: 0;
    width: 30px; height: 30px; border-radius: 50%;
    display: grid; place-items: center; font-size: .9rem; font-weight: 700;
    background: #1f6feb; color: #fff;
  }
  .feature-faq details {
    border: 1px solid rgba(0,0,0,.1); border-radius: 10px;
    padding: 12px 16px; margin: 0 0 10px;
  }
  .feature-faq summary { cursor: pointer; font-weight: 600; }
  .feature-faq p { margin: 10px 0 0; line-height: 1.6; }
  .feature-bottom {
    border: 1px solid rgba(0,0,0,.1); border-radius: 14px;
    padding: 24px; margin: 40px 0 32px; background: rgba(0,0,0,.02);
  }
  .feature-bottom h2 { margin: 0 0 8px; }
  .feature-bottom p { margin: 0 0 16px; line-height: 1.6; }
  .feature-related ul { margin: 10px 0 0 20px; line-height: 1.7; }
  @media (prefers-color-scheme: dark) {
    .feature-shot img { border-color: rgba(255,255,255,.12); }
    .feature-block :global(code),
    .feature-block :global(kbd) { background: rgba(255,255,255,.08); }
    .feature-block :global(kbd) { border-color: rgba(255,255,255,.25); }
    .feature-steps > li { border-bottom-color: rgba(255,255,255,.1); }
    .feature-faq details { border-color: rgba(255,255,255,.14); }
    .feature-bottom { border-color: rgba(255,255,255,.14); background: rgba(255,255,255,.03); }
  }
</style>
