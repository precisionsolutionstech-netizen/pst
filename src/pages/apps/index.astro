---
import Base from '../../layouts/Base.astro';
import apps from '../../data/apps.json';
import featureData from '../../data/app-features.json';

const SITE = 'https://precisionsolutionstech.com';
const live = apps.filter((a) => !a.comingSoon);
const soon = apps.filter((a) => a.comingSoon);

// Deep links to the per-feature guides. These pages are reachable from the
// Twinkeep product page and the sitemap; surfacing them on the apps hub as
// well gives them a second internal path.
const twinkeepFeatures = ((featureData as Record<string, { slug: string; name: string; summary?: string }[]>)
  .twinkeep ?? []);

const title = 'macOS Apps — Native Mac Utilities for Everyday Work';
const description =
  'Native macOS apps: Twinkeep, a duplicate photo and file cleaner on the Mac App Store, and PrecisDesk for screen capture, recording and window layouts.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'macOS Apps',
    numberOfItems: apps.length,
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE}/apps/${a.slug}/`,
      name: a.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Apps', item: `${SITE}/apps/` },
    ],
  },
];
---

<Base title={title} description={description} path="/apps/" active="apps" jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li>Apps</li>
      </ol>
    </nav>

    <header class="prose" style="margin-bottom: 8px;">
      <h1>macOS Apps</h1>
      <p class="lead">
        Native Mac utilities from Precision Solutions Tech — local-first tools for media cleanup,
        screenshots, window layouts, and printing. Twinkeep is available now; PrecisDesk is coming soon.
      </p>
    </header>

    {live.length > 0 && (
      <section class="section" style="padding: 32px 0 8px;">
        <div class="section-head" style="margin-bottom: 20px;">
          <h2>Available now</h2>
          <p>
            Buy on the
            <a href="https://apps.apple.com/us/app/twinkeep/id6804921120?mt=12" rel="noopener">Mac App Store</a>
            or download a trial and license via Gumroad.
          </p>
        </div>
        <div class="card-grid">
          {live.map((a) => {
            const icon = (a as { icon?: string }).icon;
            return (
              <a class="card app-card" href={`/apps/${a.slug}/`}>
                {icon && (
                  <img class="app-card-icon" src={icon} alt="" width="48" height="48" decoding="async" />
                )}
                <h3>{a.name}</h3>
                <p>{(a as { tagline?: string }).tagline || a.shortDescription}</p>
                <span class="card-meta">
                  <span class="pill pill-accent">{a.os}</span>
                  {a.price && <span class="pill pill-success">{a.price}</span>}
                  <span class="pill pill-success">Live</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {twinkeepFeatures.length > 0 && (
      <section class="section" style="padding: 8px 0 24px;">
        <div class="section-head" style="margin-bottom: 16px;">
          <h2>What Twinkeep does, feature by feature</h2>
          <p>Each tool has its own guide covering what it looks at and what it will not touch.</p>
        </div>
        <ul class="feature-links">
          {twinkeepFeatures.map((f) => (
            <li><a href={`/apps/twinkeep/${f.slug}/`}>{f.name}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="section prose" style="padding: 8px 0 24px;">
      <h2>How these apps are built</h2>
      <p>
        Every app here is native macOS, written in Swift and SwiftUI rather than wrapped
        from the web. They run entirely on your Mac: no account to create, no telemetry,
        and nothing uploaded. Twinkeep runs inside the App Sandbox with access only to the
        folders you pick, and hashes files locally with CryptoKit.
      </p>
      <p>
        Pricing is a one-time purchase, not a subscription. Twinkeep costs the same
        <strong>$9.99</strong> whether you buy it on the Mac App Store or take a direct
        license — the difference is that the direct build comes with a 7-day trial first,
        while the App Store version is licensed the moment you buy it. Both are the same app.
      </p>
      <p>
        Anything destructive is reversible by default. Twinkeep moves files to Quarantine
        rather than deleting them, and restoring puts a file back exactly where it came from.
        Permanently emptying Quarantine is the one action it will not do without asking.
      </p>
    </section>

    {soon.length > 0 && (
      <section class="section" style="padding: 24px 0 32px;">
        <div class="section-head" style="margin-bottom: 20px;">
          <h2>Coming soon</h2>
          <p>
            Watch our
            <a href="https://solutionsprecision.gumroad.com/" rel="noopener">Gumroad store</a>
            for release — or browse each app for the full feature list.
          </p>
        </div>
        <div class="card-grid">
          {soon.map((a) => (
            <a class="card" href={`/apps/${a.slug}/`}>
              <h3>{a.name}</h3>
              <p>{a.shortDescription}</p>
              <span class="card-meta">
                <span class="pill pill-accent">{a.os}</span>
                <span class="pill">Coming soon</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .feature-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 8px 20px;
  }
  .feature-links a { text-decoration: none; }
  .feature-links a:hover { text-decoration: underline; }
  .app-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 11px;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.12);
  }
</style>
