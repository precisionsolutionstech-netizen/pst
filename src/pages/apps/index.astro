---
import Base from '../../layouts/Base.astro';
import apps from '../../data/apps.json';

const SITE = 'https://precisionsolutionstech.com';

const title = 'macOS Apps | Coming Soon | Precision Solutions Tech';
const description =
  'Native macOS apps from Precision Solutions Tech — Twinkeep for duplicate media cleanup and PrecisDesk for capture, window layouts, and AirPrint. Coming soon.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'macOS Apps',
    numberOfItems: apps.length,
    itemListElement: apps.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE}/apps/${a.slug}/`,
      name: a.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Apps', item: `${SITE}/apps/` },
    ],
  },
];
---

<Base title={title} description={description} path="/apps/" active="apps" jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li>Apps</li>
      </ol>
    </nav>

    <header class="prose" style="margin-bottom: 8px;">
      <h1>macOS Apps</h1>
      <p class="lead">
        Native Mac utilities from Precision Solutions Tech — local-first tools for media cleanup,
        screenshots, window layouts, and printing. Both apps below are in final packaging.
      </p>
      <p>
        <span class="pill">Coming soon</span>
      </p>
    </header>

    <section class="section" style="padding: 32px 0;">
      <div class="section-head" style="margin-bottom: 20px;">
        <h2>Coming soon</h2>
        <p>
          Watch our
          <a href="https://solutionsprecision.gumroad.com/" rel="noopener">Gumroad store</a>
          for release — or browse each app for the full feature list.
        </p>
      </div>
      <div class="card-grid">
        {apps.map((a) => (
          <a class="card" href={`/apps/${a.slug}/`}>
            <h3>{a.name}</h3>
            <p>{a.shortDescription}</p>
            <span class="card-meta">
              <span class="pill pill-accent">{a.os}</span>
              <span class="pill">Coming soon</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
