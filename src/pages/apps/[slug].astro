---
import Base from '../../layouts/Base.astro';
import apps from '../../data/apps.json';

export function getStaticPaths() {
  return apps.map((a) => ({ params: { slug: a.slug }, props: { app: a } }));
}

const { app: a } = Astro.props;
const SITE = 'https://precisionsolutionstech.com';
const pagePath = `/apps/${a.slug}/`;

const related = apps.filter((r) => r.slug !== a.slug);
const screenshots = (a as { screenshots?: { src: string; alt: string; caption?: string }[] }).screenshots ?? [];

const title = `${a.name} | macOS App | Precision Solutions Tech`;
const description = a.shortDescription.length > 158
  ? a.shortDescription.slice(0, 155).replace(/\s+\S*$/, '') + '…'
  : a.shortDescription;

const imageUrl = screenshots[0]
  ? `${SITE}${screenshots[0].src}`
  : `${SITE}/og-default.png`;

const appEntity = a.comingSoon
  ? {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: a.name,
      description: a.shortDescription,
      url: `${SITE}${pagePath}`,
      image: imageUrl,
      creativeWorkStatus: 'Incomplete',
      author: { '@type': 'Organization', name: 'Precision Solutions Tech' },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: a.name,
      description: a.shortDescription,
      url: `${SITE}${pagePath}`,
      image: imageUrl,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'macOS',
      offers: a.purchaseUrl
        ? {
            '@type': 'Offer',
            priceCurrency: 'USD',
            url: a.purchaseUrl,
            availability: 'https://schema.org/InStock',
          }
        : undefined,
    };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Apps', item: `${SITE}/apps/` },
      { '@type': 'ListItem', position: 3, name: a.name, item: `${SITE}${pagePath}` },
    ],
  },
  appEntity,
];
---

<Base
  title={title}
  description={description}
  path={pagePath}
  ogType="article"
  active="apps"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/apps/">Apps</a></li>
        <li>{a.name}</li>
      </ol>
    </nav>

    <article>
      <header class="product-hero">
        <div class="hero-pills">
          <span class="pill pill-accent">macOS app</span>
          {a.categories.map((c: string) => <span class="pill">{c}</span>)}
          {a.comingSoon && <span class="pill">Coming soon</span>}
        </div>
        <h1>{a.name}</h1>
        {a.tagline && <p class="lead" style="margin-bottom: 8px; font-weight: 500; color: var(--ink);">{a.tagline}</p>}
        <p class="lead">{a.shortDescription}</p>

        <div class="cta-row">
          {(a as { appStoreUrl?: string }).appStoreUrl && (
            <a class="btn btn-accent" href={(a as { appStoreUrl?: string }).appStoreUrl} rel="noopener">
              Get on the Mac App Store{a.price ? ` — ${a.price}` : ''}
            </a>
          )}
          {a.trialDownloadUrl && (
            <a class={`btn ${(a as { appStoreUrl?: string }).appStoreUrl ? 'btn-secondary' : 'btn-accent'}`} href={a.trialDownloadUrl} download>
              Download free 7-day trial
            </a>
          )}
          {a.purchaseUrl ? (
            <a class="btn btn-secondary" href={a.purchaseUrl} rel="noopener">
              Buy on Gumroad{a.price ? ` — ${a.price}` : ''}
            </a>
          ) : (
            !a.trialDownloadUrl && !(a as { appStoreUrl?: string }).appStoreUrl && (
              <a class="btn btn-secondary" href="https://solutionsprecision.gumroad.com/" rel="noopener">
                Coming soon — visit our Gumroad store
              </a>
            )
          )}
        </div>
        {a.trialDownloadUrl && (
          <p class="cta-sub" style="margin-top: 6px;">
            Direct trial runs in the app for 7 days.
            {(a as { appStoreUrl?: string }).appStoreUrl ? (
              <>
                {' '}
                Prefer Apple?{' '}
                <a href={(a as { appStoreUrl?: string }).appStoreUrl} rel="noopener">Mac App Store</a>
                {' · '}
              </>
            ) : null}
            {a.purchaseUrl ? (
              <>
                License via <a href={a.purchaseUrl} rel="noopener">Gumroad</a>.
              </>
            ) : null}
          </p>
        )}
        {a.os && (
          <p class="cta-sub" style="margin-top: 6px;">
            Requires {a.os} · Apple Silicon or Intel
            {(a as { appStoreUrl?: string }).appStoreUrl ? ' · Mac App Store or notarized direct build' : ' · notarized direct build'}
          </p>
        )}
      </header>

      {screenshots.length > 0 && (
        <section class="shot-gallery" aria-label={`${a.name} screenshots`} data-shot-gallery>
          <div class="shot-frame">
            <figure class="shot-main">
              <img
                src={screenshots[0].src}
                alt={screenshots[0].alt}
                width="1280"
                height="800"
                decoding="async"
                data-shot-main
              />
            </figure>
            <button type="button" class="shot-nav shot-nav-prev" aria-label="Previous screenshot" data-shot-prev>
              ‹
            </button>
            <button type="button" class="shot-nav shot-nav-next" aria-label="Next screenshot" data-shot-next>
              ›
            </button>
          </div>
          <div class="shot-dots" role="tablist" aria-label="Screenshot slides">
            {screenshots.map((s, i) => (
              <button
                type="button"
                class:list={['shot-dot', { active: i === 0 }]}
                role="tab"
                aria-label={s.caption ? `${s.caption} screenshot` : `Screenshot ${i + 1}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-shot-index={i}
                data-shot-src={s.src}
                data-shot-alt={s.alt}
              />
            ))}
          </div>
        </section>
      )}

      <div class="product-body app-body" set:html={a.contentHtml} />

      <section class="product-body" style="margin-top: 48px;">
        <div class="cta-row">
          {(a as { appStoreUrl?: string }).appStoreUrl && (
            <a class="btn btn-accent" href={(a as { appStoreUrl?: string }).appStoreUrl} rel="noopener">
              Get on the Mac App Store{a.price ? ` — ${a.price}` : ''}
            </a>
          )}
          {a.trialDownloadUrl && (
            <a class={`btn ${(a as { appStoreUrl?: string }).appStoreUrl ? 'btn-secondary' : 'btn-accent'}`} href={a.trialDownloadUrl} download>
              Download free 7-day trial
            </a>
          )}
          {a.purchaseUrl ? (
            <a class="btn btn-secondary" href={a.purchaseUrl} rel="noopener">
              Buy on Gumroad{a.price ? ` — ${a.price}` : ''}
            </a>
          ) : (
            !a.trialDownloadUrl && !(a as { appStoreUrl?: string }).appStoreUrl && (
              <a class="btn btn-secondary" href="https://solutionsprecision.gumroad.com/" rel="noopener">
                Follow our Gumroad store for the release
              </a>
            )
          )}
        </div>
      </section>

      {related.length > 0 && (
        <section class="product-body related-apis" style="margin-top: 40px;">
          <h2>More macOS apps</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/apps/${r.slug}/`}>{r.name}</a> — {r.shortDescription.slice(0, 110)}{r.shortDescription.length > 110 ? '…' : ''}
              </li>
            ))}
          </ul>
          <p><a class="browse-all" href="/apps/">Browse all macOS apps &rarr;</a></p>
        </section>
      )}
    </article>
  </div>
</Base>

{screenshots.length > 0 && (
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-shot-gallery]');
      if (!root) return;
      const main = root.querySelector('[data-shot-main]');
      const dots = [...root.querySelectorAll('[data-shot-index]')];
      if (!main || !dots.length) return;
      let index = 0;
      const show = (next) => {
        index = (next + dots.length) % dots.length;
        const dot = dots[index];
        main.src = dot.getAttribute('data-shot-src');
        main.alt = dot.getAttribute('data-shot-alt') || '';
        dots.forEach((d, i) => {
          const on = i === index;
          d.classList.toggle('active', on);
          d.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      };
      root.querySelector('[data-shot-prev]')?.addEventListener('click', () => show(index - 1));
      root.querySelector('[data-shot-next]')?.addEventListener('click', () => show(index + 1));
      dots.forEach((d) => d.addEventListener('click', () => show(Number(d.getAttribute('data-shot-index')))));
    })();
  </script>
)}

<style>
  .shot-gallery {
    margin: 28px 0 8px;
    max-width: 920px;
  }
  .shot-frame {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    background: #fff;
  }
  .shot-main {
    margin: 0;
  }
  .shot-main img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }
  .shot-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: rgba(255, 255, 255, 0.95);
    color: #111;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .shot-nav:hover {
    background: #fff;
  }
  .shot-nav-prev { left: 12px; }
  .shot-nav-next { right: 12px; }
  .shot-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    margin-top: 14px;
  }
  .shot-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: 1.5px solid #111;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }
  .shot-dot.active {
    background: #111;
    border-color: #111;
  }

  .app-body :global(h2) {
    font-size: 1.4rem;
    margin: 36px 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  .app-body :global(blockquote) {
    margin: 1em 0;
    padding: 10px 18px;
    border-left: 3px solid var(--accent);
    background: var(--bg-soft);
    border-radius: 0 8px 8px 0;
  }
  .app-body :global(blockquote p) { margin: 0; }
</style>
