---
import Base from '../../layouts/Base.astro';
import apps from '../../data/apps.json';
import featureData from '../../data/app-features.json';

export function getStaticPaths() {
  return apps.map((a) => ({ params: { slug: a.slug }, props: { app: a } }));
}

const { app: a } = Astro.props;
const SITE = 'https://precisionsolutionstech.com';
const pagePath = `/apps/${a.slug}/`;

const related = apps.filter((r) => r.slug !== a.slug);
const screenshots = (a as { screenshots?: { src: string; alt: string; caption?: string }[] }).screenshots ?? [];
const highlights = (a as { highlights?: { title: string; body: string }[] }).highlights ?? [];
const trustPoints = (a as { trustPoints?: string[] }).trustPoints ?? [];
const appFeatures = ((featureData as Record<string, any[]>)[a.slug] ?? []);
const pitch = (a as { pitch?: string }).pitch;
const icon = (a as { icon?: string }).icon;
const ogImage = (a as { ogImage?: string }).ogImage;
const appStoreUrl = (a as { appStoreUrl?: string }).appStoreUrl;
const version = (a as { version?: string }).version;
const featureList = (a as { featureList?: string[] }).featureList ?? [];
const faqs = (a as { faqs?: { q: string; a: string }[] }).faqs ?? [];
const metaTitle = (a as { metaTitle?: string }).metaTitle;
const trialUrl = (a as { trialDownloadUrl?: string }).trialDownloadUrl;

const title = metaTitle || `${a.name} | macOS App | Precision Solutions Tech`;
const description = a.shortDescription.length > 158
  ? a.shortDescription.slice(0, 155).replace(/\s+\S*$/, '') + '…'
  : a.shortDescription;

const imageUrl = ogImage
  ? `${SITE}${ogImage}`
  : screenshots[0]
    ? `${SITE}${screenshots[0].src}`
    : `${SITE}/og-default.jpg`;

const publisher = { '@type': 'Organization', name: 'Precision Solutions Tech', url: `${SITE}/` };
const priceValue = a.price ? a.price.replace('$', '') : undefined;

// Twinkeep is sold through two channels at the same price; both must be
// represented or the App Store link is the only purchase path search engines
// and assistants ever see.
const offers = [
  appStoreUrl && {
    '@type': 'Offer',
    name: 'Mac App Store',
    price: priceValue,
    priceCurrency: 'USD',
    url: appStoreUrl,
    availability: 'https://schema.org/InStock',
    seller: publisher,
  },
  a.purchaseUrl && {
    '@type': 'Offer',
    name: 'Direct license (Gumroad)',
    price: priceValue,
    priceCurrency: 'USD',
    url: a.purchaseUrl,
    availability: 'https://schema.org/InStock',
    seller: publisher,
  },
].filter(Boolean);

const appEntity = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: a.name,
  description: a.shortDescription,
  url: `${SITE}${pagePath}`,
  image: imageUrl,
  applicationCategory: 'UtilitiesApplication',
  applicationSubCategory: a.categories?.[0],
  operatingSystem: a.os || 'macOS',
  ...(a.os ? { softwareRequirements: `${a.os}, Apple Silicon or Intel` } : {}),
  ...(version ? { softwareVersion: version } : {}),
  ...(featureList.length ? { featureList } : {}),
  ...(screenshots.length
    ? { screenshot: screenshots.map((s) => `${SITE}${s.src}`) }
    : {}),
  publisher,
  author: publisher,
  ...(a.comingSoon
    ? { releaseNotes: 'In development — not yet released.' }
    : {
        ...(trialUrl ? { downloadUrl: `${SITE}${trialUrl}` } : {}),
        ...(offers.length ? { offers } : {}),
      }),
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Apps', item: `${SITE}/apps/` },
      { '@type': 'ListItem', position: 3, name: a.name, item: `${SITE}${pagePath}` },
    ],
  },
  appEntity,
  ...(faqs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }]
    : []),
];
---

<Base
  title={title}
  description={description}
  path={pagePath}
  ogType="article"
  ogImage={ogImage || (screenshots[0] ? screenshots[0].src : undefined)}
  active="apps"
  jsonLd={jsonLd}
>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/apps/">Apps</a></li>
        <li>{a.name}</li>
      </ol>
    </nav>

    <article>
      <header class="app-hero">
        <div class="app-hero-copy">
          <div class="app-hero-brand">
            {icon && (
              <img
                class="app-icon"
                src={icon}
                alt=""
                width="88"
                height="88"
                decoding="async"
              />
            )}
            <div class="app-hero-titles">
              <p class="app-kicker">macOS · Utilities</p>
              <h1>{a.name}</h1>
              {a.tagline && <p class="app-tagline">{a.tagline}</p>}
            </div>
          </div>

          <p class="app-pitch">{pitch || a.shortDescription}</p>

          {!a.comingSoon && (
            <div class="app-cta">
              <div class="app-cta-row">
                {appStoreUrl && (
                  <a class="btn btn-mas" href={appStoreUrl} rel="noopener">
                    <svg class="mas-apple" viewBox="0 0 14 17" aria-hidden="true" width="16" height="19">
                      <path fill="currentColor" d="M13.07 5.82c-.08.06-1.48.85-1.48 2.6 0 2.03 1.78 2.75 1.84 2.77-.03.07-.29 1-.95 1.97-.57.85-1.16 1.7-2.09 1.72-.91.02-1.2-.54-2.25-.54s-1.38.52-2.25.56c-.9.04-1.58-.92-2.16-1.76C2.43 11.2 1.4 8.4 2.72 6.5c.66-.94 1.84-1.54 3.12-1.56.97-.02 1.89.66 2.25.66.36 0 1.46-.81 2.47-.69.42.02 1.6.17 2.36 1.28-.06.04-.45.26-.85.63zM9.4 2.9c.5-.63.86-1.5.74-2.4-.72.03-1.63.5-2.15 1.12-.47.55-.9 1.44-.79 2.28.83.06 1.69-.42 2.2-1z"/>
                    </svg>
                    <span class="mas-label">
                      <span class="mas-small">Get on the</span>
                      <span class="mas-big">Mac App Store{a.price ? ` · ${a.price}` : ''}</span>
                    </span>
                  </a>
                )}
                {a.trialDownloadUrl && (
                  <a class="btn btn-secondary btn-trial" href={a.trialDownloadUrl} download>
                    Download free 7-day trial
                  </a>
                )}
              </div>

              <p class="app-cta-alt">
                {a.trialDownloadUrl && <>Trial unlocks in-app for 7 days.</>}
                {a.purchaseUrl && (
                  <>
                    {' '}
                    Prefer a direct license?{' '}
                    <a href={a.purchaseUrl} rel="noopener">Buy on Gumroad{a.price ? ` — ${a.price}` : ''}</a>
                  </>
                )}
              </p>

              {trustPoints.length > 0 && (
                <ul class="app-trust" aria-label="Why Twinkeep">
                  {trustPoints.map((t) => <li>{t}</li>)}
                </ul>
              )}

              {a.os && (
                <p class="app-reqs">
                  Requires {a.os} · Apple Silicon or Intel
                  {appStoreUrl ? ' · Mac App Store or notarized direct build' : ' · notarized direct build'}
                </p>
              )}
            </div>
          )}

          {a.comingSoon && (
            <div class="app-cta">
              <div class="app-cta-row">
                <a class="btn btn-secondary" href="https://solutionsprecision.gumroad.com/" rel="noopener">
                  Coming soon — visit our Gumroad store
                </a>
              </div>
              {a.os && <p class="app-reqs">Requires {a.os}</p>}
            </div>
          )}
        </div>
      </header>

      {screenshots.length > 0 && (
        <section class="shot-gallery" aria-label={`${a.name} screenshots`} data-shot-gallery>
          <div class="shot-frame">
            <figure class="shot-main">
              <img
                src={screenshots[0].src}
                alt={screenshots[0].alt}
                width="1280"
                height="800"
                decoding="async"
                data-shot-main
              />
            </figure>
            <button type="button" class="shot-nav shot-nav-prev" aria-label="Previous screenshot" data-shot-prev>
              ‹
            </button>
            <button type="button" class="shot-nav shot-nav-next" aria-label="Next screenshot" data-shot-next>
              ›
            </button>
          </div>
          <p class="shot-caption" data-shot-caption>{screenshots[0].caption || screenshots[0].alt}</p>
          <div class="shot-dots" role="tablist" aria-label="Screenshot slides">
            {screenshots.map((s, i) => (
              <button
                type="button"
                class:list={['shot-dot', { active: i === 0 }]}
                role="tab"
                aria-label={s.caption ? `${s.caption} screenshot` : `Screenshot ${i + 1}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-shot-index={i}
                data-shot-src={s.src}
                data-shot-alt={s.alt}
                data-shot-cap={s.caption || s.alt}
              />
            ))}
          </div>
        </section>
      )}

      {highlights.length > 0 && (
        <section class="app-highlights" aria-label="What you get">
          {highlights.map((h) => (
            <div class="app-highlight">
              <h2>{h.title}</h2>
              <p>{h.body}</p>
            </div>
          ))}
        </section>
      )}

      {appFeatures.length > 0 && (
        <section class="feature-guides" aria-label={`${a.name} feature guides`}>
          <h2>How each feature works</h2>
          <p class="feature-guides-intro">
            Step-by-step guides for every part of {a.name} — what it is for, how to set it up,
            and what it does to your files.
          </p>
          <ul class="feature-guide-list">
            {appFeatures.map((f: any) => (
              <li>
                <a href={`/apps/${a.slug}/${f.slug}/`}>
                  <span class="feature-guide-name">{f.name}</span>
                  <span class="feature-guide-blurb">{f.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="product-body app-body" set:html={a.contentHtml} />

      {faqs.length > 0 && (
        <section class="product-body app-faq" id="faq" style="margin-top: 40px;">
          <h2 id="faq-heading">Frequently asked questions</h2>
          {faqs.map((f) => (
            <details class="app-faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      {!a.comingSoon && (
        <section class="app-bottom-cta" aria-label={`Get ${a.name}`}>
          <div class="app-bottom-cta-inner">
            <div>
              <h2>Ready to reclaim the space?</h2>
              <p>One-time purchase. Local on your Mac. Quarantine before anything is gone for good.</p>
            </div>
            <div class="app-cta-row">
              {appStoreUrl && (
                <a class="btn btn-mas" href={appStoreUrl} rel="noopener">
                  <svg class="mas-apple" viewBox="0 0 14 17" aria-hidden="true" width="16" height="19">
                    <path fill="currentColor" d="M13.07 5.82c-.08.06-1.48.85-1.48 2.6 0 2.03 1.78 2.75 1.84 2.77-.03.07-.29 1-.95 1.97-.57.85-1.16 1.7-2.09 1.72-.91.02-1.2-.54-2.25-.54s-1.38.52-2.25.56c-.9.04-1.58-.92-2.16-1.76C2.43 11.2 1.4 8.4 2.72 6.5c.66-.94 1.84-1.54 3.12-1.56.97-.02 1.89.66 2.25.66.36 0 1.46-.81 2.47-.69.42.02 1.6.17 2.36 1.28-.06.04-.45.26-.85.63zM9.4 2.9c.5-.63.86-1.5.74-2.4-.72.03-1.63.5-2.15 1.12-.47.55-.9 1.44-.79 2.28.83.06 1.69-.42 2.2-1z"/>
                  </svg>
                  <span class="mas-label">
                    <span class="mas-small">Get on the</span>
                    <span class="mas-big">Mac App Store{a.price ? ` · ${a.price}` : ''}</span>
                  </span>
                </a>
              )}
              {a.trialDownloadUrl && (
                <a class="btn btn-secondary btn-trial" href={a.trialDownloadUrl} download>
                  Download free 7-day trial
                </a>
              )}
            </div>
          </div>
          {a.purchaseUrl && (
            <p class="app-cta-alt" style="margin-top: 14px;">
              Or <a href={a.purchaseUrl} rel="noopener">buy a direct license on Gumroad</a>
              {a.price ? ` — ${a.price}` : ''}.
            </p>
          )}
        </section>
      )}

      {related.length > 0 && (
        <section class="product-body related-apis" style="margin-top: 40px;">
          <h2>More macOS apps</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/apps/${r.slug}/`}>{r.name}</a> — {r.shortDescription.slice(0, 110)}{r.shortDescription.length > 110 ? '…' : ''}
              </li>
            ))}
          </ul>
          <p><a class="browse-all" href="/apps/">Browse all macOS apps &rarr;</a></p>
        </section>
      )}
    </article>
  </div>
</Base>

{screenshots.length > 0 && (
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-shot-gallery]');
      if (!root) return;
      const main = root.querySelector('[data-shot-main]');
      const caption = root.querySelector('[data-shot-caption]');
      const dots = [...root.querySelectorAll('[data-shot-index]')];
      if (!main || !dots.length) return;
      let index = 0;
      const show = (next) => {
        index = (next + dots.length) % dots.length;
        const dot = dots[index];
        main.src = dot.getAttribute('data-shot-src');
        main.alt = dot.getAttribute('data-shot-alt') || '';
        if (caption) caption.textContent = dot.getAttribute('data-shot-cap') || '';
        dots.forEach((d, i) => {
          const on = i === index;
          d.classList.toggle('active', on);
          d.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      };
      root.querySelector('[data-shot-prev]')?.addEventListener('click', () => show(index - 1));
      root.querySelector('[data-shot-next]')?.addEventListener('click', () => show(index + 1));
      dots.forEach((d) => d.addEventListener('click', () => show(Number(d.getAttribute('data-shot-index')))));
    })();
  </script>
)}

<style>
  .feature-guides { margin: 44px 0 8px; }
  .feature-guides h2 { font-size: 1.5rem; margin: 0 0 6px; }
  .feature-guides-intro { margin: 0 0 18px; opacity: .8; line-height: 1.55; }
  .feature-guide-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  @media (min-width: 720px) { .feature-guide-list { grid-template-columns: 1fr 1fr; } }
  .feature-guide-list a {
    display: block; height: 100%; padding: 16px 18px; border-radius: 12px;
    border: 1px solid rgba(0,0,0,.1); text-decoration: none; color: inherit;
    transition: border-color .15s ease, transform .15s ease;
  }
  .feature-guide-list a:hover { border-color: #1f6feb; transform: translateY(-1px); }
  .feature-guide-name { display: block; font-weight: 650; margin-bottom: 4px; color: #1f6feb; }
  .feature-guide-blurb { display: block; font-size: .93rem; line-height: 1.5; opacity: .78; }
  @media (prefers-color-scheme: dark) {
    .feature-guide-list a { border-color: rgba(255,255,255,.14); }
  }

  .app-hero {
    padding: 20px 0 8px;
    max-width: 820px;
  }

  .app-hero-brand {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 18px;
  }

  .app-icon {
    width: 88px;
    height: 88px;
    border-radius: 20px;
    flex-shrink: 0;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.55) inset,
      0 10px 28px rgba(15, 23, 42, 0.14);
  }

  .app-kicker {
    margin: 0 0 4px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .app-hero-titles h1 {
    margin: 0;
    font-size: clamp(2.15rem, 4vw, 2.75rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .app-tagline {
    margin: 8px 0 0;
    font-size: 1.22rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.015em;
  }

  .app-pitch {
    margin: 0 0 22px;
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 40rem;
  }

  .app-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 12px;
  }

  .btn-mas {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #111827;
    color: #fff;
    border-color: #111827;
    padding: 10px 18px 10px 14px;
    border-radius: 12px;
    line-height: 1.15;
  }
  .btn-mas:hover {
    background: #000;
    border-color: #000;
    color: #fff;
    text-decoration: none;
  }
  .mas-apple { flex-shrink: 0; }
  .mas-label {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
  }
  .mas-small {
    font-size: 0.68rem;
    font-weight: 500;
    opacity: 0.78;
    letter-spacing: 0.01em;
  }
  .mas-big {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .btn-trial {
    display: inline-flex;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .app-cta-alt {
    margin: 12px 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .app-trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
  }
  .app-trust li {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 11px;
  }

  .app-reqs {
    margin: 12px 0 0;
    font-size: 0.86rem;
    color: var(--faint);
  }

  .shot-gallery {
    margin: 28px 0 8px;
    max-width: 960px;
  }
  .shot-frame {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0f172a;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.12);
  }
  .shot-main { margin: 0; }
  .shot-main img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    background: #fff;
  }
  .shot-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.94);
    color: #111;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .shot-nav:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.04);
  }
  .shot-nav-prev { left: 14px; }
  .shot-nav-next { right: 14px; }
  .shot-caption {
    margin: 12px 0 0;
    text-align: center;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--muted);
  }
  .shot-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 9px;
    margin-top: 10px;
  }
  .shot-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: 1.5px solid #111;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }
  .shot-dot.active {
    background: #111;
    border-color: #111;
  }

  .app-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin: 36px 0 8px;
    max-width: 960px;
  }
  .app-highlight {
    padding: 4px 2px 8px;
    border-top: 2px solid var(--ink);
  }
  .app-highlight h2 {
    margin: 14px 0 8px;
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }
  .app-highlight p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .app-body {
    margin-top: 28px;
  }
  .app-body :global(h2) {
    font-size: 1.4rem;
    margin: 36px 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  .app-body :global(blockquote) {
    margin: 1em 0;
    padding: 10px 18px;
    border-left: 3px solid var(--accent);
    background: var(--bg-soft);
    border-radius: 0 8px 8px 0;
  }
  .app-body :global(blockquote p) { margin: 0; }

  .app-bottom-cta {
    margin: 48px 0 8px;
    max-width: 960px;
    padding: 28px 28px 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background:
      linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }
  .app-bottom-cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .app-bottom-cta h2 {
    margin: 0 0 6px;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .app-bottom-cta p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 28rem;
  }

  @media (max-width: 800px) {
    .app-highlights { grid-template-columns: 1fr; gap: 22px; }
    .app-icon { width: 72px; height: 72px; border-radius: 16px; }
    .app-bottom-cta { padding: 22px; }
  }

  @media (max-width: 520px) {
    .app-cta-row { flex-direction: column; align-items: stretch; }
    .btn-mas, .btn-trial { justify-content: center; width: 100%; }
  }
</style>
